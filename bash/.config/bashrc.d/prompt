# Collapse the prompt once the path alone exceeds this many characters.
: "${PROMPT_DIR_MAX_LEN:=40}"

parse_git_branch() {
    git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/(\1)/'
}

# Reduce a path to "<root>/.../<last folder>", keeping the "~" marker so a
# location under $HOME still reads as one.
collapse_path() {
    local path="$1" root rest last

    if [[ "$path" == \~* ]]; then
        root="~"
        rest="${path#\~}"
    else
        root=""
        rest="$path"
    fi
    rest="${rest#/}"
    last="${rest##*/}"

    # Nothing between the root and the last folder to elide.
    if [[ "$rest" == "$last" ]]; then
        printf '%s' "${root}/${last}"
        return
    fi

    printf '%s' "${root}/.../${last}"
}

build_prompt() {
    local full

    full="${PWD/#$HOME/\~}"
    __prompt_git="$(parse_git_branch)"

    if (( ${#full} > PROMPT_DIR_MAX_LEN )); then
        __prompt_uh="${USER:0:1}@${HOSTNAME:0:1}"
        __prompt_path="$(collapse_path "$full")"
    else
        __prompt_uh="${USER}@${HOSTNAME%%.*}"
        __prompt_path="$full"
    fi

    # Values go in via variables, not inline: prompt expansion does not rescan
    # what it expanded, so a directory or branch named '$(cmd)' stays literal.
    PS1="\[\e[93m\](\A) \[\e[92m\]\${__prompt_uh} \[\e[38;5;27m\]\${__prompt_path}"
    [[ -n "$__prompt_git" ]] && PS1+=" \[\e[91m\]\${__prompt_git}"
    PS1+="\[\e[0m\] \$ "
}

PROMPT_COMMAND=build_prompt
